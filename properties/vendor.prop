# DPM
persist.vendor.dpm.vndr.feature=11

# DRM
drm.service.enabled=true

# Fingerprint
persist.vendor.qfp=true
ro.hardware.fp.sideCap=true
ro.hardware.fp.mievent=true

# FRP
ro.frp.pst=/dev/block/bootdevice/by-name/frp

# Fuse
persist.sys.fuse.passthrough.enable=true

# Gatekeeper
vendor.gatekeeper.is_security_level_spu=0

# Incremental
ro.incremental.enable=yes

# Keystore
ro.hardware.keystore_desede=true
vendor.keymint.retry_timer=5

# Media
debug.c2.use_dmabufheaps=1
debug.stagefright.c2inputsurface=-1
debug.stagefright.ccodec=4
debug.stagefright.omx_default_rank=0
media.c2.hal.selection=aidl

# Perf
ro.vendor.extension_library=libqti-perfd-client.so

# QSPM
ro.vendor.qspm.enable=true

# Radio
persist.radio.multisim.config=dsds
persist.vendor.radio.apm_sim_not_pwdn=1
persist.vendor.radio.custom_ecc=1
persist.vendor.radio.dsds_to_ss=0
persist.vendor.radio.dsds_to_ss_timer=120000
persist.vendor.radio.enableadvancedscan=true
persist.vendor.radio.procedure_bytes=SKIP
persist.vendor.radio.sib16_support=1
persist.vendor.rcs.singlereg.feature=2

# Secure Processor
vendor.secureprocessor.service_start=1

# Sensors
persist.vendor.sensors.enable.mag_filter=true
persist.vendor.sensors.support_direct_channel=false

# SOC
ro.soc.manufacturer=QTI

# Sys Daemon
persist.vendor.qcomsysd.enabled=1

# Trusted UI
vendor.trustedui.service_start=1

# USB
vendor.usb.controller=4e00000.dwc3
vendor.usb.diag.func.name=ffs
vendor.usb.dpl.inst.name=dpl
vendor.usb.qdss.inst.name=qdss_sw
vendor.usb.rmnet.func.name=gsi
vendor.usb.rmnet.inst.name=rmnet
vendor.usb.rndis.func.name=gsi
vendor.usb.use_ffs_mtp=1
vendor.usb.use_gadget_hal=1

