<!--
    Device VINTF manifest for Xiaomi steppe (SM4850 / malabar)
    Firmware: OS3.0.313.0.WAVMIXM (Android 16)
-->
<manifest version="9.0" type="device" target-level="202504">
    <!-- Gatekeeper (secure lock screen) -->
    <hal format="aidl">
        <name>android.hardware.gatekeeper</name>
        <fqname>IGatekeeper/default</fqname>
    </hal>
    <!-- Fingerprint -->
    <hal format="aidl">
        <name>android.hardware.biometrics.fingerprint</name>
        <version>4</version>
        <fqname>IFingerprint/default</fqname>
    </hal>
    <hal format="aidl">
        <name>vendor.xiaomi.hardware.fingerprintextension</name>
        <fqname>IXiaomiFingerprint/default</fqname>
    </hal>
    <hal format="aidl">
        <name>vendor.xiaomi.hardware.fx.tunnel</name>
        <fqname>IMiFxTunnel/default</fqname>
    </hal>
    <!-- Weaver (credential storage hardware) -->
    <hal format="aidl">
        <name>android.hardware.weaver</name>
        <version>2</version>
        <fqname>IWeaver/default</fqname>
    </hal>
    <sepolicy>
        <version>202504</version>
    </sepolicy>
</manifest>

